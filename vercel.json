{
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/.prisma/client/**,server/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=$1" },
    { "source": "/api", "destination": "/api?__path=" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
